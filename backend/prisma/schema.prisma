// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 用户模型
model User {
  id        Int      @id @default(autoincrement()) // 主键，自增
  username  String   @unique // 用户名，唯一
  password  String // 加密后的密码
  email     String?  @unique // 新增邮箱字段，可选且唯一（可选
  role      String   @default("child") // 角色：elder（老人）或 child（子女），默认老人
  createdAt DateTime @default(now()) @map("created_at") // 创建时间，默认当前时间
  updatedAt DateTime @updatedAt @map("updated_at") // 更新时间，自动更新

  // 关联关系：一个用户可以有多个提醒
  reminders        Reminder[]
  PushSubscription PushSubscription[]
  HealthRecord     HealthRecord[]
  EmergencyContact EmergencyContact[]
  EmergencyLog     EmergencyLog[]

  @@map("users") // 指定数据库表名为 users
}

// 提醒模型
model Reminder {
  id          Int      @id @default(autoincrement())
  title       String // 提醒标题
  description String? // 提醒描述（可选）
  remindAt    DateTime // 提醒时间
  userId      Int // 外键，关联用户ID
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  taken    Boolean @default(false) // 是否已提醒/已吃
  medicine String // 药品名
  time     String // 提醒时间（HH:mm格式）

  // 关联关系：提醒属于某个用户
  user User @relation(fields: [userId], references: [id])

  @@map("reminders")
}

// 订阅存储模型
model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique @db.VarChar(500) // 添加 @db.Text 以支持长 URL
  p256dh    String
  auth      String
  userId    Int? // 可选关联用户
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

// 健康记录表
model HealthRecord {
  id         Int      @id @default(autoincrement())
  title      String // 记录标题，如“降压药服用记录”
  content    String? // 详细内容（支持多行文本）
  recordType String // 类型：medicine（药品）或 checkup（体检）
  recordDate DateTime // 记录日期，默认为当前时间
  userId     Int // 所属老人用户ID
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("health_records")
}

// 紧急联系人
model EmergencyContact {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("emergency_contacts")
}

// 求助记录
model EmergencyLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  latitude  Float?
  longitude Float?
  location  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("emergency_logs")
}
