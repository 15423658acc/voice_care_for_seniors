// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 用户模型
model User {
  id       Int     @id @default(autoincrement()) // 主键，自增
  username String  @unique // 用户名，唯一
  password String // 加密后的密码
  email    String? @unique // 新增邮箱字段，可选且唯一（可选
  role     String  @default("child") // 角色：elder（老人）或 child（子女），默认老人

  // 老人登录系统新增字段 （子女和老人通过同一个 User 表中的自关联实现关联）
  parentId Int?    @map("parent_id") // 关联子女的用户ID，仅老人有值
  // parentId 可选外键，parent字段将这个指向同一个表的id字段
  fullName String? @map("full_name")
  phone    String?
  age      Int?

  createdAt DateTime @default(now()) @map("created_at") // 创建时间，默认当前时间
  updatedAt DateTime @updatedAt @map("updated_at") // 更新时间，自动更新

  // 关联关系：老人所属的子女
  parent   User?  @relation("ChildToElder", fields: [parentId], references: [id])
  // 反向关联：子女拥有的老人列表（子女可以通过 children 查询到所有关联的老人，老人可以通过 parent 查询到自己的子女。）
  children User[] @relation("ChildToElder")

  // 关联关系：一个用户可以有多个提醒
  reminders        Reminder[]
  PushSubscription PushSubscription[]
  HealthRecord     HealthRecord[]
  EmergencyContact EmergencyContact[]
  EmergencyLog     EmergencyLog[]

  // 找回密码
  resetToken       String?   @map("reset_token") // 重置密码令牌（哈希值）
  resetTokenExpiry DateTime? @map("reset_token_expiry") // 令牌过期时间

  @@map("users") // 指定数据库表名为 users
}

// 提醒模型
model Reminder {
  id          Int      @id @default(autoincrement())
  title       String // 提醒标题
  description String? // 提醒描述（可选）
  remindAt    DateTime // 提醒时间
  userId      Int // 外键，关联用户ID
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  taken    Boolean @default(false) // 是否已提醒/已吃
  medicine String // 药品名
  time     String // 提醒时间（HH:mm格式）

  // 新增字段 ：实现循环提醒
  repeatType   String?   @default("none") @map("repeat_type") // none / daily / every_other_day / weekly
  nextRemindAt DateTime? @map("next_remind_at") // 下一次应提醒的时间（UTC）

  // 关联关系：提醒属于某个用户
  user User @relation(fields: [userId], references: [id])

  @@map("reminders")
}

// 订阅存储模型
model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @db.VarChar(500) // 添加 @db.Text 以支持长 URL，用户设备的推送链接
  p256dh    String // 安全密钥
  auth      String // 安全密钥
  userId    Int? // 可选关联用户
  role      String // 新增】角色：'elder' 或 'child'，用于区分订阅用途
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  // 【新增】唯一约束：同一用户在同一设备上的订阅唯一
  @@unique([endpoint, userId])
  @@map("push_subscriptions")
}

// 健康记录表
model HealthRecord {
  id         Int      @id @default(autoincrement())
  title      String // 记录标题，如“降压药服用记录”
  content    String? // 详细内容（支持多行文本）
  recordType String // 类型：medicine（药品）或 checkup（体检）
  recordDate DateTime // 记录日期，默认为当前时间
  userId     Int // 所属老人用户ID
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("health_records")
}

// 紧急联系人
model EmergencyContact {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("emergency_contacts")
}

// 求助记录
model EmergencyLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  latitude  Float?
  longitude Float?
  location  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("emergency_logs")
}
